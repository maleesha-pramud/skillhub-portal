    </main>
    <footer class="app-footer">
        <span>&copy; <c:out value="${applicationScope.academyName}"/>, Colombo, Sri Lanka</span>
        <span>Need help? <a href="mailto:${fn:escapeXml(applicationScope.supportEmail)}"><c:out value="${applicationScope.supportEmail}"/></a></span>
    </footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="${ctx}/assets/js/app.js"></script>
</body>
</html>
