<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SkillHub Training Academy Portal</display-name>
    <description>Training management portal: students, trainers, courses, enrolments and attendance.</description>

    <!-- ===================== Application-wide settings (ServletContext init-params) ===================== -->
    <context-param>
        <param-name>academyName</param-name>
        <param-value>SkillHub Training Academy</param-value>
    </context-param>
    <context-param>
        <param-name>supportEmail</param-name>
        <param-value>support@skillhub.lk</param-value>
    </context-param>
    <context-param>
        <param-name>defaultCapacity</param-name>
        <param-value>30</param-value>
    </context-param>
    <context-param>
        <param-name>registrationOpen</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- ===================== Listeners ===================== -->
    <listener>
        <listener-class>com.skillhub.listener.AppContextListener</listener-class>
    </listener>
    <listener>
        <listener-class>com.skillhub.listener.SessionTrackingListener</listener-class>
    </listener>
    <listener>
        <listener-class>com.skillhub.listener.RequestStatsListener</listener-class>
    </listener>

    <!-- ===================== Filters (execution order = order of the mappings) ===================== -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.skillhub.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>com.skillhub.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.skillhub.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>com.skillhub.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.skillhub.filter.CsrfFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ===================== Servlets ===================== -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CourseServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.CourseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>EnrolmentServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.EnrolmentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AttendanceServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AttendanceMarkServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AttendanceMarkServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminStudentServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AdminStudentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminTrainerServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AdminTrainerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AdminUserServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminSettingsServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AdminSettingsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AdminReportServlet</servlet-name>
        <servlet-class>com.skillhub.servlet.AdminReportServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CourseServlet</servlet-name>
        <url-pattern>/courses</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>EnrolmentServlet</servlet-name>
        <url-pattern>/enrolments</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/attendance</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AttendanceMarkServlet</servlet-name>
        <url-pattern>/attendance/mark</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminStudentServlet</servlet-name>
        <url-pattern>/admin/students</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminTrainerServlet</servlet-name>
        <url-pattern>/admin/trainers</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminSettingsServlet</servlet-name>
        <url-pattern>/admin/settings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminReportServlet</servlet-name>
        <url-pattern>/admin/reports</url-pattern>
    </servlet-mapping>

    <!-- ===================== Session management ===================== -->
    <session-config>
        <session-timeout>20</session-timeout>
        <cookie-config>
            <name>SKILLHUBSESSION</name>
            <http-only>true</http-only>
            <!-- Set <secure>true</secure> when the site is served over HTTPS -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ===================== JSP configuration ===================== -->
    <jsp-config>
        <jsp-property-group>
            <description>All JSP pages: UTF-8, JSTL tag libraries pre-loaded, no stray whitespace</description>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <scripting-invalid>true</scripting-invalid>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
            <include-prelude>/WEB-INF/jspf/taglibs.jspf</include-prelude>
        </jsp-property-group>
        <jsp-property-group>
            <description>Shared JSP fragments (header, footer, flash messages)</description>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <scripting-invalid>true</scripting-invalid>
        </jsp-property-group>
    </jsp-config>

    <!-- ===================== Security ===================== -->
    <!-- Declarative security: block HTTP methods the application never uses (TRACE, PUT, DELETE, OPTIONS...). -->
    <security-constraint>
        <display-name>Block unused HTTP methods</display-name>
        <web-resource-collection>
            <web-resource-name>Unsupported methods</web-resource-name>
            <url-pattern>/*</url-pattern>
            <http-method-omission>GET</http-method-omission>
            <http-method-omission>POST</http-method-omission>
            <http-method-omission>HEAD</http-method-omission>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>

    <!-- Authentication (login filter + session) and authorisation (role filter) are implemented in
         AuthenticationFilter and AuthorizationFilter; see the report, section 10. -->

    <!-- ===================== Error pages ===================== -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>405</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/jsp/error.jsp</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
